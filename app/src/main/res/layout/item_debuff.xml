<?xml version="1.0" encoding="utf-8"?>
<!-- One (de)buff on the character details: name and remove, the value (only for valued conditions
     such as Frightened 2) and the duration in rounds, a description and, for a spell, its caster
     and End on all targets. DebuffAdapter binds it. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/debuff_cardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_2"
    app:contentPaddingBottom="@dimen/space_3"
    app:contentPaddingEnd="@dimen/space_1"
    app:contentPaddingStart="@dimen/space_3"
    app:contentPaddingTop="@dimen/space_3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Rekijan.TextInputLayout.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/debuff_card_name">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/debuff_name_editText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>

            <ImageButton
                android:id="@+id/remove_debuff_button"
                style="@style/Widget.Rekijan.IconButton"
                android:contentDescription="@string/debuff_card_remove_button"
                android:src="@drawable/ic_delete" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:layout_marginEnd="@dimen/space_3"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Only shown for valued conditions such as Frightened 2 -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/debuff_value_textView"
                style="@style/Widget.Rekijan.TextInputLayout.Outlined.Row"
                android:layout_marginEnd="@dimen/space_2"
                android:hint="@string/debuff_card_value_label">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/debuff_value_editText"
                    style="@style/Widget.Rekijan.NumberField"
                    android:gravity="center"
                    android:maxLength="2"
                    android:textStyle="bold" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Rekijan.TextInputLayout.Outlined.Row"
                android:hint="@string/debuff_card_duration_label">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/debuff_duration_editText"
                    style="@style/Widget.Rekijan.NumberField"
                    android:gravity="center" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Rekijan.TextInputLayout.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:layout_marginEnd="@dimen/space_3"
            android:hint="@string/debuff_card_description">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/debuff_description_editText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- GM only, for a valued condition: the lock (not below a value; for some rounds counted on
             a chosen character's turn, until unlocked, or while a spell lasts) -->
        <LinearLayout
            android:id="@+id/debuff_lock_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:layout_marginEnd="@dimen/space_3"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/debuff_lock_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="@dimen/space_1"
                android:minHeight="@dimen/touch_target"
                android:text="@string/debuff_lock"
                android:textAppearance="@style/TextAppearance.Rekijan.LabelLarge"
                android:textColor="?attr/colorOnSurface"
                app:drawableStartCompat="@drawable/ic_lock"
                app:drawableTint="?attr/colorSecondary" />

            <TextView
                android:id="@+id/debuff_lock_spell_textView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Rekijan.M3BodySmall"
                android:textColor="?attr/colorSecondary"
                android:visibility="gone"
                tools:text="Locked while Fear lasts"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/debuff_lock_fields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Rekijan.TextInputLayout.Outlined.Row"
                    android:layout_marginEnd="@dimen/space_2"
                    android:hint="@string/lock_min">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/debuff_lock_min_editText"
                        style="@style/Widget.Rekijan.NumberField"
                        android:gravity="center"
                        android:maxLength="2" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/debuff_lock_rounds_layout"
                    style="@style/Widget.Rekijan.TextInputLayout.Outlined.Row"
                    android:hint="@string/debuff_lock_rounds">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/debuff_lock_rounds_editText"
                        style="@style/Widget.Rekijan.NumberField"
                        android:gravity="center"
                        android:maxLength="4" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/debuff_lock_counter_layout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:hint="@string/debuff_lock_counter"
                app:helperText="@string/debuff_lock_rounds_hint">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/debuff_lock_counter_dropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Only for a spell: who cast it, and (GM only) ending it on every target -->
        <LinearLayout
            android:id="@+id/debuff_spell_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:layout_marginEnd="@dimen/space_3"
            android:gravity="center_vertical"
            android:minHeight="@dimen/touch_target"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/debuff_caster_textView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawablePadding="@dimen/space_1"
                android:gravity="center_vertical"
                android:textAppearance="@style/TextAppearance.Rekijan.M3BodySmall"
                android:textColor="?attr/colorSecondary"
                app:drawableStartCompat="@drawable/ic_spellbook"
                app:drawableTint="?attr/colorSecondary"
                tools:text="Cast by Kyra" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/debuff_end_all_button"
                style="@style/Widget.Rekijan.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/debuff_end_all" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
