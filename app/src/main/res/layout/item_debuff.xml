<?xml version="1.0" encoding="utf-8"?>
<!-- One (de)buff on the character details: name and remove, the value (only for valued conditions
     such as Frightened 2) and the duration in rounds, and a description. DebuffAdapter binds it. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/debuff_cardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_2"
    app:contentPaddingBottom="@dimen/space_3"
    app:contentPaddingEnd="@dimen/space_1"
    app:contentPaddingStart="@dimen/space_3"
    app:contentPaddingTop="@dimen/space_3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Rekijan.TextInputLayout.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/debuff_card_name">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/debuff_name_editText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>

            <ImageButton
                android:id="@+id/remove_debuff_button"
                style="@style/Widget.Rekijan.IconButton"
                android:contentDescription="@string/debuff_card_remove_button"
                android:src="@drawable/ic_delete" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:layout_marginEnd="@dimen/space_3"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Only shown for valued conditions such as Frightened 2 -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/debuff_value_textView"
                style="@style/Widget.Rekijan.TextInputLayout.Outlined.Row"
                android:layout_marginEnd="@dimen/space_2"
                android:hint="@string/debuff_card_value_label">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/debuff_value_editText"
                    style="@style/Widget.Rekijan.NumberField"
                    android:gravity="center"
                    android:maxLength="2"
                    android:textStyle="bold" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Rekijan.TextInputLayout.Outlined.Row"
                android:hint="@string/debuff_card_duration_label">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/debuff_duration_editText"
                    style="@style/Widget.Rekijan.NumberField"
                    android:gravity="center" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Rekijan.TextInputLayout.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:layout_marginEnd="@dimen/space_3"
            android:hint="@string/debuff_card_description">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/debuff_description_editText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
