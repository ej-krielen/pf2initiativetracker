<?xml version="1.0" encoding="utf-8"?>
<!-- One standard condition in the condition wizard: name, description (can be hidden), the value
     (only for valued conditions such as Frightened) and rounds, and Add. ConditionWizardAdapter
     binds it. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/condition_cardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/condition_name_textView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Rekijan.CardTitle"
            android:textColor="?attr/colorOnSurface"
            tools:text="Frightened" />

        <TextView
            android:id="@+id/condition_description_textView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:textAppearance="@style/TextAppearance.Rekijan.BodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="You're gripped by fear and struggle to control your nerves." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Only shown for valued conditions -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/condition_value_textView"
                style="@style/Widget.Rekijan.TextInputLayout.Outlined.Row"
                android:layout_marginEnd="@dimen/space_2"
                android:hint="@string/condition_card_value_label">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/condition_value_editText"
                    style="@style/Widget.Rekijan.NumberField"
                    android:gravity="center"
                    android:maxLength="2"
                    android:textStyle="bold" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Rekijan.TextInputLayout.Outlined.Row"
                android:layout_marginEnd="@dimen/space_2"
                android:hint="@string/condition_card_duration_label">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/condition_duration_editText"
                    style="@style/Widget.Rekijan.NumberField"
                    android:gravity="center" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/add_condition_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/char_detail_add_button"
                app:icon="@drawable/ic_add" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
