<?xml version="1.0" encoding="utf-8"?>
<!-- One character in the initiative order: a PC (gold), NPC (bordeaux) or dying (red) tinted card
     with a marker stripe, the initiative and name (editable in place), the hp (tap to change), a
     details button, the (de)buffs and persistent damage, the reaction row (can be folded away) and,
     while dying, the dying track. CharacterAdapter sets the colors and the active-turn outline. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/initiative_character_cardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_2"
    app:contentPadding="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <View
            android:id="@+id/initiative_character_marker_view"
            android:layout_width="@dimen/card_marker_width"
            android:layout_height="match_parent"
            tools:background="@color/rk_pc_marker" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_2"
            android:paddingTop="@dimen/space_2"
            android:paddingBottom="@dimen/space_2">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout style="@style/Widget.Rekijan.StatBox">

                    <EditText
                        android:id="@+id/initiative_character_initiative_editText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:gravity="center"
                        android:hint="@string/char_card_initiative_hint"
                        android:imeOptions="actionDone"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLength="5"
                        android:minHeight="32dp"
                        android:padding="0dp"
                        android:selectAllOnFocus="true"
                        android:textAppearance="@style/TextAppearance.Rekijan.StatValue"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="22" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/char_card_initiative"
                        android:textAppearance="@style/TextAppearance.Rekijan.StatLabel" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/space_2"
                    android:paddingEnd="@dimen/space_2">

                    <EditText
                        android:id="@+id/initiative_character_name_editText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:hint="@string/EH_character_name"
                        android:imeOptions="actionDone"
                        android:importantForAutofill="no"
                        android:inputType="textPersonName|textCapWords"
                        android:minHeight="@dimen/touch_target"
                        android:padding="0dp"
                        android:textAppearance="@style/TextAppearance.Rekijan.CardTitle"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="Valeros" />

                    <!-- PC / NPC, hero points or Dying, in the marker color -->
                    <TextView
                        android:id="@+id/initiative_character_type_textView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="-8dp"
                        android:textAppearance="@style/TextAppearance.Rekijan.StatLabel"
                        tools:text="PC · 1 hero point"
                        tools:textColor="@color/rk_pc_marker" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/initiative_character_hp_box"
                    style="@style/Widget.Rekijan.StatBox"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingStart="@dimen/space_2"
                    android:paddingEnd="@dimen/space_2">

                    <TextView
                        android:id="@+id/initiative_character_hp_textView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:minHeight="32dp"
                        android:textAppearance="@style/TextAppearance.Rekijan.StatValue"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="31 / 48" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/char_card_hp"
                        android:textAppearance="@style/TextAppearance.Rekijan.StatLabel" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/initiative_character_detail_button"
                    style="@style/Widget.Rekijan.IconButton"
                    android:contentDescription="@string/char_card_show_more"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <!-- (De)buffs, valued conditions in bold, e.g. "Frightened 2 · Off-Guard (1)" -->
            <TextView
                android:id="@+id/initiative_character_debuff_overview_textView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:layout_marginEnd="@dimen/space_3"
                android:drawablePadding="@dimen/space_1"
                android:textAppearance="@style/TextAppearance.Rekijan.M3BodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone"
                app:drawableStartCompat="@drawable/ic_auto_awesome"
                app:drawableTint="?attr/colorSecondary"
                tools:text="Frightened 2 · Off-Guard (1) · Bless (3)"
                tools:visibility="visible" />

            <!-- Persistent damage, e.g. "1d6 fire · DC 15" -->
            <TextView
                android:id="@+id/initiative_character_persistent_textView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:layout_marginEnd="@dimen/space_3"
                android:drawablePadding="@dimen/space_1"
                android:textAppearance="@style/TextAppearance.Rekijan.M3BodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone"
                app:drawableStartCompat="@drawable/ic_flame"
                app:drawableTint="@color/rk_dying"
                tools:text="1d6 fire persistent · DC 15"
                tools:visibility="visible" />

            <!-- Reactions: the reaction toggle (resets at the start of the turn), the custom
                 reactions, and folding the row away. The menu hides it on every card. -->
            <LinearLayout
                android:id="@+id/initiative_character_reaction_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:orientation="vertical">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginEnd="@dimen/space_2"
                    android:background="?attr/colorOutlineVariant" />

                <LinearLayout
                    android:id="@+id/initiative_character_reaction_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/initiative_character_reaction_available_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_target"
                        android:paddingStart="@dimen/space_1"
                        android:paddingEnd="0dp"
                        android:text="@string/char_card_reaction"
                        android:textAppearance="@style/TextAppearance.Rekijan.LabelLarge"
                        android:textColor="?attr/colorOnSurface"
                        app:switchPadding="@dimen/space_2" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/initiative_character_reactions_button"
                        style="@style/Widget.Rekijan.Button.Text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="end|center_vertical"
                        android:maxLines="1"
                        tools:text="2 other reactions ready" />

                    <ImageButton
                        android:id="@+id/initiative_character_collapse_reaction_button"
                        style="@style/Widget.Rekijan.IconButton"
                        android:contentDescription="@string/char_card_hide_reactions"
                        android:src="@drawable/ic_expand_less"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <!-- Folded: only the way back -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/initiative_character_open_reaction_button"
                    style="@style/Widget.Rekijan.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:minHeight="40dp"
                    android:text="@string/char_card_show_reactions"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone"
                    app:icon="@drawable/ic_expand_more"
                    app:iconGravity="end"
                    app:iconTint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <!-- Dying: the numbers, the rules, and the track (one step per point up to max dying) -->
            <LinearLayout
                android:id="@+id/initiative_character_dying_block"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/initiative_character_dying_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.Rekijan.M3BodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="Dying 2 of 4 · Wounded 1 · Doomed 1 · Recovery DC 12" />

                    <ImageButton
                        android:id="@+id/initiative_character_dying_rules_imageView"
                        style="@style/Widget.Rekijan.IconButton"
                        android:contentDescription="@string/dialog_dying_rules_title"
                        android:src="@drawable/ic_info"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/initiative_character_dying_layout"
                    android:baselineAligned="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_2"
                    android:orientation="horizontal">

                    <TextView style="@style/Widget.Rekijan.DyingStep" tools:text="1" />

                    <TextView style="@style/Widget.Rekijan.DyingStep" tools:text="2" />

                    <TextView style="@style/Widget.Rekijan.DyingStep" tools:text="3" />

                    <TextView style="@style/Widget.Rekijan.DyingStep" tools:text="4" />

                    <TextView style="@style/Widget.Rekijan.DyingStep" tools:text="5" />

                    <TextView style="@style/Widget.Rekijan.DyingStep" tools:text="6" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
