<?xml version="1.0" encoding="utf-8"?>
<!-- Add a (de)buff to a character: an empty one, persistent damage or a poison, or one of the
     standard conditions (search, hide the descriptions). Scrolls as one page so the list keeps
     its room at a large font size. ConditionWizardFragment wires it. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="@dimen/space_3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_3"
        android:paddingTop="@dimen/space_2"
        android:paddingEnd="@dimen/space_3">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_2"
            android:text="@string/debuff_wizard_add_header"
            android:textAppearance="@style/TextAppearance.Rekijan.SectionHeader" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/debuff_wizard_add_empty_button"
                style="@style/Widget.Rekijan.Button.Tonal.Wizard"
                android:text="@string/add_empty" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/debuff_wizard_add_persistent_damage_button"
                style="@style/Widget.Rekijan.Button.Tonal.Wizard"
                android:layout_marginStart="@dimen/space_2"
                android:text="@string/add_persistent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/debuff_wizard_add_poison_button"
                style="@style/Widget.Rekijan.Button.Tonal.Wizard"
                android:layout_marginStart="@dimen/space_2"
                android:text="@string/add_poison" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:text="@string/debuff_wizard_conditions_header"
            android:textAppearance="@style/TextAppearance.Rekijan.SectionHeader" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Rekijan.TextInputLayout.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:hint="@string/debuff_wizard_search"
            app:endIconMode="clear_text"
            app:startIconDrawable="@drawable/ic_search">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/debuff_wizard_searchView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/debuff_wizard_description_checkBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:minHeight="@dimen/touch_target"
            android:text="@string/debuff_wizard_hide_desc"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <TextView
            android:id="@+id/debuff_wizard_reminder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_2"
            android:text="@string/debuff_wizard_reminder"
            android:textAppearance="@style/TextAppearance.Rekijan.M3BodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/debuff_wizard_recyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
