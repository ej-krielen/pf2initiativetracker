<?xml version="1.0" encoding="utf-8"?>
<!-- Content of the recovery check dialog (title and Cancel come from the dialog builder): the DC,
     then one button per result with what it does to the dying value. HealthDialogs wires it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_4"
    android:paddingTop="@dimen/space_1"
    android:paddingEnd="@dimen/space_4">

    <TextView
        android:id="@+id/recovery_dialog_dc_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="Recovery Check is DC12 (This is a flat check)." />

    <LinearLayout style="@style/Widget.Rekijan.DialogRow">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/recovery_dialog_crit_success_btn"
            style="@style/Widget.Rekijan.Button.Dialog.Row"
            android:text="@string/dialog_button_crit_success" />

        <TextView
            style="@style/Widget.Rekijan.DialogRow.Text"
            android:text="@string/dialog_recovery_info_crit_success" />
    </LinearLayout>

    <LinearLayout style="@style/Widget.Rekijan.DialogRow">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/recovery_dialog_success_btn"
            style="@style/Widget.Rekijan.Button.Dialog.Row"
            android:text="@string/dialog_button_success" />

        <TextView
            style="@style/Widget.Rekijan.DialogRow.Text"
            android:text="@string/dialog_recovery_info_success" />
    </LinearLayout>

    <LinearLayout style="@style/Widget.Rekijan.DialogRow">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/recovery_dialog_failure_btn"
            style="@style/Widget.Rekijan.Button.Dialog.Row"
            android:text="@string/dialog_button_failure" />

        <TextView
            style="@style/Widget.Rekijan.DialogRow.Text"
            android:text="@string/dialog_recovery_info_failure" />
    </LinearLayout>

    <LinearLayout style="@style/Widget.Rekijan.DialogRow">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/recovery_dialog_crit_failure_btn"
            style="@style/Widget.Rekijan.Button.Dialog.Row"
            android:text="@string/dialog_button_crit_failure" />

        <TextView
            style="@style/Widget.Rekijan.DialogRow.Text"
            android:text="@string/dialog_recovery_info_crit_failure" />
    </LinearLayout>
</LinearLayout>
