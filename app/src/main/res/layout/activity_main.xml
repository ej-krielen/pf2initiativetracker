<?xml version="1.0" encoding="utf-8"?>
<!--
    Main screen: toolbar, the panes (content_main: the encounter, or the details / Edit Order in
    its place; on a large screen the details sit next to the list; or the profile list or a
    player character) and the ad bar under both panes, with the navigation drawer over it.
    The ad bar takes its own space, so it never covers the turn bar. Edge-to-edge: MainActivity pads
    the root and the drawer for the status bar, navigation bar and keyboard, so nothing here uses
    fitsSystemWindows.
-->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/colorBackground"
        android:orientation="vertical">

        <!-- wrap_content plus minHeight: grows with a large font size instead of clipping the title -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            app:title="@string/app_name"
            app:titleTextColor="@color/rk_wordmark" />

        <include
            layout="@layout/content_main"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Ad bar: stays GONE (zero height) until an ad has loaded, and for Remove Ads owners -->
        <nl.rekijan.ads.RekijanBannerAdView
            android:id="@+id/bottomAdBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/colorBackground"
            android:visibility="gone" />
    </LinearLayout>

    <!-- The drawer: its whole content is the header (nav_header). MainActivity pads it for the
         status bar and navigation bar, so no fitsSystemWindows and no inset scrims. -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:bottomInsetScrimEnabled="false"
        app:headerLayout="@layout/nav_header"
        app:topInsetScrimEnabled="false" />

</androidx.drawerlayout.widget.DrawerLayout>
