<?xml version="1.0" encoding="utf-8"?>
<!-- One persistent damage on the character details: name and remove, damage type, damage, flat
     check DC and duration, and a description. Marked with the flame. DebuffAdapter binds it. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/persistent_damage_cardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_2"
    app:contentPaddingBottom="@dimen/space_3"
    app:contentPaddingEnd="@dimen/space_1"
    app:contentPaddingStart="@dimen/space_3"
    app:contentPaddingTop="@dimen/space_3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="@dimen/space_2"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_flame"
                app:tint="@color/rk_dying" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Rekijan.TextInputLayout.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/persistent_name_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/persistent_damage_name_editText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences" />
            </com.google.android.material.textfield.TextInputLayout>

            <ImageButton
                android:id="@+id/remove_persistent_damage_button"
                style="@style/Widget.Rekijan.IconButton"
                android:contentDescription="@string/debuff_card_remove_button"
                android:src="@drawable/ic_delete" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:layout_marginEnd="@dimen/space_3"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Rekijan.TextInputLayout.Outlined.Row"
                android:layout_marginEnd="@dimen/space_2"
                android:hint="@string/persistent_type_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/persistent_damage_type_editText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Rekijan.TextInputLayout.Outlined.Row"
                android:hint="@string/persistent_damage_label">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/persistent_damage_value_editText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:layout_marginEnd="@dimen/space_3"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Rekijan.TextInputLayout.Outlined.Row"
                android:layout_marginEnd="@dimen/space_2"
                android:hint="@string/persistent_dc_label">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/persistent_damage_dc_editText"
                    style="@style/Widget.Rekijan.NumberField"
                    android:gravity="center" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Rekijan.TextInputLayout.Outlined.Row"
                android:hint="@string/persistent_duration_label">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/persistent_damage_duration_editText"
                    style="@style/Widget.Rekijan.NumberField"
                    android:gravity="center" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Rekijan.TextInputLayout.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:layout_marginEnd="@dimen/space_3"
            android:hint="@string/persistent_description_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/persistent_damage_description_editText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
