<?xml version="1.0" encoding="utf-8"?>
<!-- Toolbar: only the encounter actions. PCs to max HP and Sort as icons, the rest in the overflow
     menu. Next turn and the round are in the turn bar under the encounter. Add, Delete characters,
     Edit order, Switch profile and the app items (Remove Ads, Tip, About, ...) are in the
     navigation drawer. No <group>: AppCompat moves a whole group to the overflow when one item does
     not fit, so MainActivity.ENCOUNTER_ACTIONS shows and hides them per item. -->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".app.MainActivity">

    <item
        android:id="@+id/action_settings_set_pcs_max_hp"
        android:icon="@drawable/ic_heal"
        android:orderInCategory="1"
        android:title="@string/action_set_pcs_max_hp_short"
        app:showAsAction="always" />
    <item
        android:id="@+id/action_settings_sort"
        android:icon="@drawable/ic_sort"
        android:orderInCategory="2"
        android:title="@string/action_sort"
        app:showAsAction="always" />
    <item
        android:id="@+id/action_settings_reset_round"
        android:orderInCategory="3"
        android:title="@string/action_reset_round"
        app:showAsAction="never" />
    <item
        android:id="@+id/action_settings_hide_reactions"
        android:checkable="true"
        android:orderInCategory="4"
        android:title="@string/action_hide_reactions"
        app:showAsAction="never" />
    <item
        android:id="@+id/action_settings_start_turn_info"
        android:orderInCategory="5"
        android:title="@string/action_start_turn_info"
        app:showAsAction="never" />
    <item
        android:id="@+id/action_settings_end_turn_info"
        android:orderInCategory="6"
        android:title="@string/action_end_turn_info"
        app:showAsAction="never" />
</menu>
