<?xml version="1.0" encoding="utf-8"?>
<!-- Styles that only PF2 Combat Tracker needs, built on the shared theme in themes.xml
     (same theme as Initiative Tracker, Secret Roller and Mook Roller). -->
<resources>

    <!-- ===== Text ===== -->

    <style name="TextAppearance.Rekijan.Body" parent="TextAppearance.Rekijan.BodyLarge">
        <item name="android:textSize">17sp</item>
        <item name="android:lineHeight">27sp</item>
    </style>

    <style name="TextAppearance.Rekijan.BodySmall" parent="TextAppearance.Rekijan.BodyMedium">
        <item name="android:textSize">15sp</item>
        <item name="android:lineHeight">22sp</item>
    </style>

    <!-- Group heading ("ROUND", "NOTES"): small caps-like label in gold -->
    <style name="TextAppearance.Rekijan.SectionHeader" parent="TextAppearance.Rekijan.LabelLarge">
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">?attr/colorSecondary</item>
    </style>

    <!-- Character name on a card -->
    <style name="TextAppearance.Rekijan.CardTitle" parent="TextAppearance.Rekijan.TitleLarge">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Numbers in the initiative and hp boxes and the round counter -->
    <style name="TextAppearance.Rekijan.StatValue" parent="TextAppearance.Rekijan.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <!-- Small caps label under a number ("INIT", "HP") and the PC / NPC tag -->
    <style name="TextAppearance.Rekijan.StatLabel" parent="TextAppearance.Rekijan.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- ===== Widgets ===== -->

    <!-- Outlined text field (character details, dialogs): 12dp corners like the buttons, gold
         border and label when focused. Same as Mook Roller. -->
    <style name="Widget.Rekijan.TextInputLayout.Outlined" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="shapeAppearance">@style/ShapeAppearance.Rekijan.Small</item>
        <item name="boxStrokeColor">@color/text_input_stroke</item>
        <item name="hintTextColor">?attr/colorSecondary</item>
    </style>

    <!-- Square button with only an icon (round counter, Edit Order arrows) -->
    <style name="Widget.Rekijan.Button.Icon">
        <item name="android:minWidth">@dimen/touch_target</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="iconPadding">0dp</item>
        <item name="iconGravity">textStart</item>
    </style>

    <style name="Widget.Rekijan.Button.Tonal.Icon">
        <item name="android:minWidth">@dimen/touch_target</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="iconPadding">0dp</item>
        <item name="iconGravity">textStart</item>
    </style>

    <!-- Filled bordeaux button inside a dialog (hp dialog). Uses the color directly, not
         ?attr/colorPrimary: inside a dialog the overlay maps colorPrimary to gold, and tonal
         buttons would match the dialog surface. -->
    <style name="Widget.Rekijan.Button.Dialog">
        <item name="backgroundTint">@color/md_primary</item>
        <item name="android:textColor">@color/md_on_primary</item>
        <item name="rippleColor">@color/ripple_on_primary</item>
        <!-- Three in a row (hp dialog): keep the label on one line, shrinking it on narrow
             screens or with a large font size instead of wrapping -->
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:maxLines">1</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">10sp</item>
        <item name="autoSizeMaxTextSize">14sp</item>
    </style>

    <!-- Borderless 48dp icon button in gold (card details, remove (de)buff) -->
    <style name="Widget.Rekijan.IconButton" parent="">
        <item name="android:layout_width">@dimen/touch_target</item>
        <item name="android:layout_height">@dimen/touch_target</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="tint">?attr/colorSecondary</item>
    </style>

    <!-- Boxed number on a card (initiative, hp): white box with a thin border -->
    <style name="Widget.Rekijan.StatBox" parent="">
        <!-- Grows past its usual width for long values (-99) or a large font size -->
        <item name="android:layout_width">wrap_content</item>
        <item name="android:minWidth">@dimen/stat_box_width</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_stat_box</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <!-- ===== PF2e ===== -->

    <!-- One step of the dying track on a dying character's card: a rounded tile with the step
         number (or a skull when doomed takes it). CharacterAdapter sets the color per step. -->
    <style name="Widget.Rekijan.DyingStep" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_dying_step</item>
        <item name="android:maxLines">1</item>
        <item name="android:textAppearance">@style/TextAppearance.Rekijan.StatValue</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- A row in a dialog: a filled button with what it does next to it (recovery check) -->
    <style name="Widget.Rekijan.DialogRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_2</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="Widget.Rekijan.Button.Dialog.Row">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
    </style>

    <style name="Widget.Rekijan.DialogRow.Text" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">@dimen/space_3</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- One of the three add buttons on top of the condition wizard: equal widths, one line that
         shrinks on a narrow screen or at a large font size -->
    <style name="Widget.Rekijan.Button.Tonal.Wizard">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/touch_target</item>
        <item name="autoSizeMaxTextSize">14sp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:maxLines">1</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">10sp</item>
    </style>

    <!-- A row of outlined fields in a form -->
    <style name="Widget.Rekijan.FieldRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_2</item>
        <item name="android:baselineAligned">false</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <!-- A whole-number field inside an outlined text field -->
    <style name="Widget.Rekijan.NumberField" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:imeOptions">actionDone</item>
        <item name="android:importantForAutofill">no</item>
        <item name="android:inputType">number</item>
        <item name="android:maxLength">5</item>
        <item name="android:selectAllOnFocus">true</item>
    </style>

    <!-- Outlined field that shares a row with others, equal widths (character details, dialogs) -->
    <style name="Widget.Rekijan.TextInputLayout.Outlined.Row">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
    </style>

</resources>
