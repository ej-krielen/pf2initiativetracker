<?xml version="1.0" encoding="utf-8"?>
<!-- Large screen: the encounter with the character details (or reactions, conditions) next to it -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <FrameLayout
        android:id="@+id/main_fragment_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />

    <!-- The second pane and this line are hidden on the profile list and a player character -->
    <View
        android:id="@+id/pane_divider"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="?attr/colorOutlineVariant" />

    <FrameLayout
        android:id="@+id/second_fragment_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />
</LinearLayout>
